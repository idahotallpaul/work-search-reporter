# Copy this file to .env and paste your real values there.
# .env is ignored by git.

OPENAI_API_KEY=sk-...

# Optional overrides. Defaults are set in src/config.ts.
# OPENAI_EXTRACT_MODEL=gpt-5.6
# OPENAI_ENRICH_MODEL=gpt-5.6

# Optional if you put the Google OAuth desktop-client JSON somewhere else.
# GOOGLE_OAUTH_CLIENT_PATH=/absolute/path/to/google-oauth-client.json
# GMAIL_TOKEN_PATH=/absolute/path/to/gmail-token.json
