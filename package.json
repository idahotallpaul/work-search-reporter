{
  "name": "work-search-reporter",
  "version": "1.0.0",
  "private": true,
  "description": "Collect Gmail job-search evidence and append it to an Idaho unemployment work-search CSV.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "collect": "ts-node --project tsconfig.json src/cli.ts",
    "count": "ts-node --project tsconfig.json src/countCli.ts",
    "dry-run": "ts-node --project tsconfig.json src/cli.ts --dry-run",
    "enrich": "ts-node --project tsconfig.json src/enrichCli.ts",
    "start": "ts-node --project tsconfig.json src/menuCli.ts",
    "preview": "ts-node --project tsconfig.json src/cli.ts --dry-run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
